# syntax=docker/dockerfile:1
# Generated by DeepAgent. Rerunning the deploy regenerates this file - delete this line to keep your own edits.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /app
# uv: uv.lock is the authority. `uv sync --frozen` installs exactly what
# the lock pins and never re-resolves - a lock out of step with
# pyproject.toml fails here, loudly, instead of being regenerated.
# The build context is the directory holding uv.lock (the workspace
# root), so the lock and every member pyproject.toml are present.
RUN pip install --no-cache-dir uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON=/usr/local/bin/python \
    UV_PYTHON_DOWNLOADS=never \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1
COPY . .
RUN uv sync --frozen --no-dev
ENV VIRTUAL_ENV=/opt/venv PATH="/opt/venv/bin:$PATH"
# Ensure the production server ("gunicorn") is present even if it's
# missing from the dependency list - otherwise the CMD fails with
# "gunicorn: not found" at container start.
RUN uv pip install --no-cache "gunicorn"

# Non-root runtime user. USER must be a NUMERIC uid - Kubernetes'
# runAsNonRoot check refuses to start a container whose USER is a name,
# because it cannot verify from outside the image that the name is non-root
# (2026-09, java-app-backend hit CreateContainerConfigError under the
# restricted profile because USER was "app" instead of a number).
RUN useradd --create-home --uid 10001 appuser && chown -R appuser /app /opt/venv
USER 10001
WORKDIR /app/backend
EXPOSE 8000
CMD ["gunicorn","-b","0.0.0.0:8000","app:app"]
