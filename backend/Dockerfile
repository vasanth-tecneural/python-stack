# syntax=docker/dockerfile:1
# Generated by DeepAgent. Rerunning the deploy regenerates this file - delete this line to keep your own edits.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /app
# No install strategy was supplied, so the packaging shape is detected at
# build time. This sees only the build context: a lockfile above it is
# invisible here. The deploy path resolves the layout up front instead.
COPY . .
RUN set -eu; \
    python -m pip install --no-cache-dir --upgrade pip; \
    if [ -f uv.lock ]; then \
      pip install --no-cache-dir uv && \
      uv export --frozen --no-dev --no-hashes --no-emit-project -o /tmp/requirements.txt && \
      pip install --no-cache-dir -r /tmp/requirements.txt; \
    elif [ -f pyproject.toml ] && [ -f poetry.lock ]; then \
      pip install --no-cache-dir poetry && \
      poetry config virtualenvs.create false --local && \
      poetry install --only main --no-interaction --no-ansi --no-root; \
    elif [ -f Pipfile.lock ]; then \
      pip install --no-cache-dir pipenv && \
      pipenv install --deploy --system; \
    elif [ -f requirements.txt ]; then \
      pip install --no-cache-dir -r requirements.txt; \
    elif [ -f pyproject.toml ]; then \
      if grep -q '^\[build-system\]' pyproject.toml; then \
        pip install --no-cache-dir .; \
      else \
        pip install --no-cache-dir uv && uv pip install --system --no-cache -r pyproject.toml; \
      fi; \
    else \
      echo "ERROR: no Python packaging file found (uv.lock, poetry.lock, Pipfile.lock, requirements.txt or pyproject.toml)" >&2; \
      exit 1; \
    fi
# Ensure the production server ("gunicorn") is present even if it's
# missing from the dependency list - otherwise the CMD fails with
# "gunicorn: not found" at container start.
RUN pip install --no-cache-dir "gunicorn"

# Non-root runtime user. USER must be a NUMERIC uid - Kubernetes'
# runAsNonRoot check refuses to start a container whose USER is a name,
# because it cannot verify from outside the image that the name is non-root
# (2026-09, java-app-backend hit CreateContainerConfigError under the
# restricted profile because USER was "app" instead of a number).
RUN useradd --create-home --uid 10001 appuser && chown -R appuser /app
USER 10001
EXPOSE 8000
CMD ["gunicorn","-b","0.0.0.0:8000","app:app"]
